[Unit]
Description=Suichuan pickup service (Node.js port of the Cloudflare Worker)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/suichuan/server
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=3
Environment=PORT=8080
Environment=HOST=0.0.0.0
# Optional overrides (defaults shown in server/README.md):
# Environment=SUICHUAN_DATA_DIR=/opt/suichuan/server/data
# Environment=SUICHUAN_MAX_BYTES=104857600

[Install]
WantedBy=multi-user.target
