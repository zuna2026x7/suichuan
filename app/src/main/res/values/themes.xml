<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base style: required as the implicit parent of the dotted styles below
         (Suichuan.BigButton / Suichuan.HintText), otherwise AAPT linking fails
         with "resource style/Suichuan not found". -->
    <style name="Suichuan" />

    <style name="Theme.Suichuan" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/suichuan_primary</item>
        <item name="colorPrimaryDark">@color/suichuan_primary_dark</item>
        <item name="colorAccent">@color/suichuan_accent</item>
    </style>

    <style name="Suichuan.BigButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <style name="Suichuan.HintText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/suichuan_text_hint</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
</resources>
