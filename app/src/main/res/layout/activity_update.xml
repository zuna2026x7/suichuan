<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="检查更新"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_current_version"
            style="@style/Suichuan.HintText" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textSize="17sp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_release"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_release_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_release_meta"
                style="@style/Suichuan.HintText" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="更新内容"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_release_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/button_primary"
            style="@style/Suichuan.BigButton"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_secondary"
            style="@style/Suichuan.BigButton"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_ignore"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="跳过这个版本"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
