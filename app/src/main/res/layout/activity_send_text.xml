<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="发一段文字"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Suichuan.HintText"
            android:text="把一段话、一个链接写到这里（或者粘贴进来），发送后会得到一个取件码。对方在随传里输入取件码，就能看到这段文字。" />

        <EditText
            android:id="@+id/edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="要发送的文字"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="4" />

        <TextView
            android:id="@+id/text_size_hint"
            style="@style/Suichuan.HintText" />

        <Button
            android:id="@+id/button_paste"
            style="@style/Suichuan.BigButton"
            android:text="从剪贴板粘贴" />

        <Button
            android:id="@+id/button_send"
            style="@style/Suichuan.BigButton"
            android:text="发送" />

        <TextView
            android:id="@+id/text_status"
            style="@style/Suichuan.HintText" />

        <ProgressBar
            android:id="@+id/progress_send"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_retry"
            style="@style/Suichuan.BigButton"
            android:text="重试"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_upload_log"
            style="@style/Suichuan.BigButton"
            android:text="上传日志帮我看看"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="取件码（72 小时内有效）"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/text_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textSize="56sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_qr"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:contentDescription="取件二维码" />

            <TextView
                style="@style/Suichuan.HintText"
                android:text="对方打开「随传」接收页，输入这个取件码就能看到这段文字；也可以用接收页的「扫码接收」扫这个二维码。" />

            <Button
                android:id="@+id/button_share"
                style="@style/Suichuan.BigButton"
                android:text="发给微信 / QQ 好友" />

            <Button
                android:id="@+id/button_done"
                style="@style/Suichuan.BigButton"
                android:text="完成，返回首页" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
