<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="面对面分享随传"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_status"
            style="@style/Suichuan.HintText"
            android:accessibilityLiveRegion="polite"
            android:text="正在准备…" />

        <LinearLayout
            android:id="@+id/layout_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/image_qr"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="随传下载二维码，对方用相机扫描即可下载" />

            <TextView
                android:id="@+id/text_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <Button
                android:id="@+id/button_copy"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="复制链接" />

            <TextView
                android:id="@+id/text_downloads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_download"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                android:visibility="gone" />

            <TextView
                style="@style/Suichuan.HintText"
                android:text="不走公网、不耗流量。请用系统相机或浏览器扫码，微信、QQ 会拦截安装包下载。商场、酒店等公共 Wi‑Fi 常常不让设备互相访问，这时请打开你的热点让对方连上。下载期间请停留在这个页面。" />
        </LinearLayout>

        <Button
            android:id="@+id/button_refresh"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="56dp"
            android:text="重新检测网络" />

        <Button
            android:id="@+id/button_stop"
            style="@style/Suichuan.BigButton"
            android:text="停止分享，返回首页" />
    </LinearLayout>
</ScrollView>
