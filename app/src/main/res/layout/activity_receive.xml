<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="接收"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Suichuan.HintText"
            android:text="扫码或粘贴只会把内容填到输入框，不会自动开始。检查一下，再点下面的“开始接收”。也可以直接输入取件码 / 分享文字 / 下载链接。" />

        <Button
            android:id="@+id/button_scan"
            style="@style/Suichuan.SecondaryButton"
            android:text="扫码接收" />

        <Button
            android:id="@+id/button_paste"
            style="@style/Suichuan.SecondaryButton"
            android:text="粘贴剪贴板内容" />

        <EditText
            android:id="@+id/edit_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="6 位取件码，或粘贴分享文字 / 链接"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <Button
            android:id="@+id/button_fetch"
            style="@style/Suichuan.BigButton"
            android:text="开始接收" />

        <TextView
            android:id="@+id/text_status"
            style="@style/Suichuan.HintText"
            android:accessibilityLiveRegion="polite" />

        <ProgressBar
            android:id="@+id/progress_download"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_cancel_download"
            style="@style/Suichuan.SecondaryButton"
            android:text="取消接收"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_upload_log"
            style="@style/Suichuan.TextButton"
            android:text="上传日志帮我看看"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="下载完成，确认安装："
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_confirm_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/text_confirm_detail"
                style="@style/Suichuan.HintText" />

            <TextView
                style="@style/Suichuan.HintText"
                android:text="提醒：这里只安装应用本身，不包含对方手机里的账号和数据。银行、支付类应用装好后也可能因为设备不同而用不了。" />

            <TextView
                android:id="@+id/text_install_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/button_open_app"
                style="@style/Suichuan.BigButton"
                android:text="打开应用"
                android:visibility="gone" />

            <Button
                android:id="@+id/button_install"
                style="@style/Suichuan.BigButton"
                android:text="安装" />

            <Button
                android:id="@+id/button_done"
                style="@style/Suichuan.TextButton"
                android:text="完成，返回首页" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="下载完成，保存这个文件："
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/text_file_detail"
                style="@style/Suichuan.HintText" />

            <TextView
                android:id="@+id/text_file_apk_note"
                style="@style/Suichuan.HintText"
                android:text="这是经「发送文件」收到的 .apk，只会保存，不会安装。想装应用请让对方走「发送应用」重新发。"
                android:visibility="gone" />

            <Button
                android:id="@+id/button_save_file"
                style="@style/Suichuan.BigButton"
                android:text="保存到下载" />

            <Button
                android:id="@+id/button_open_file"
                style="@style/Suichuan.SecondaryButton"
                android:text="打开" />

            <Button
                android:id="@+id/button_done_file"
                style="@style/Suichuan.TextButton"
                android:text="完成，返回首页" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="收到一段文字"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_received_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <Button
                android:id="@+id/button_copy_text"
                style="@style/Suichuan.BigButton"
                android:text="复制全文" />

            <Button
                android:id="@+id/button_done_text"
                style="@style/Suichuan.TextButton"
                android:text="完成，返回首页" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
