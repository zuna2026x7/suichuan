# Copy this file to wrangler.toml and fill in your own values.
#   cp wrangler.toml.example wrangler.toml
# Create the KV namespace first and paste its id below:
#   npx wrangler kv namespace create TRANSFERS

name = "suichuan-pickup"
main = "src/index.js"
compatibility_date = "2024-09-23"
workers_dev = true

[[kv_namespaces]]
binding = "TRANSFERS"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
